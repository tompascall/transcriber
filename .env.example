# Defaults use .venv/, models/, and dictionaries/ inside the repository.
# Uncomment only settings you want to override. Use literal absolute paths.
# Environment variables take precedence; no shell expansion or inline comments.
# LT_RUNTIME_DIR="/absolute/path/to/runtime"
# LT_PYTHON="/absolute/path/to/.venv/bin/python"
# LT_WHISPER="/absolute/path/to/.venv/bin/mlx_whisper"
# LT_WHISPER_MODEL="/absolute/path/to/whisper-large-v3-mlx"
# LT_DIARIZATION_MODEL="/absolute/path/to/pyannote-speaker-diarization-community-1"
# LT_HUNSPELL_DICT="/absolute/path/to/hu_HU"
# LT_CUSTOM_DICT="/absolute/path/to/custom_replacements.tsv"
# LT_FFMPEG="/absolute/path/to/ffmpeg"
# LT_HUNSPELL="/absolute/path/to/hunspell"
