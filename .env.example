# Defaults use .venv/, models/, and dictionaries/ inside the repository.
# Uncomment only settings you want to override. Use literal absolute paths.
# Environment variables take precedence; no shell expansion or inline comments.
# TRANSCRIBER_RUNTIME_DIR="/absolute/path/to/runtime"
# TRANSCRIBER_PYTHON="/absolute/path/to/.venv/bin/python"
# TRANSCRIBER_WHISPER="/absolute/path/to/.venv/bin/mlx_whisper"
# TRANSCRIBER_WHISPER_MODEL="/absolute/path/to/whisper-large-v3-mlx"
# TRANSCRIBER_DIARIZATION_MODEL="/absolute/path/to/pyannote-speaker-diarization-community-1"
# TRANSCRIBER_HUNSPELL_DICT="/absolute/path/to/hu_HU"
# TRANSCRIBER_CUSTOM_DICT="/absolute/path/to/custom_replacements.tsv"
# TRANSCRIBER_FFMPEG="/absolute/path/to/ffmpeg"
# TRANSCRIBER_HUNSPELL="/absolute/path/to/hunspell"
